{
  "name": "naijasos-resqlink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NaijaSOS / ResQLink — multi-agency emergency response coordination prototype",
  "main": "server/index.js",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "node scripts/build.js",
    "build:css": "node scripts/build.js",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/app.css --watch",
    "seed": "node server/seed.js --force",
    "reset:data": "node server/reset-data.js",
    "test": "node --test tests/geo.test.js tests/auth-tenancy.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "livekit-client": "^2.24.1",
    "livekit-server-sdk": "^2.20.0",
    "serverless-http": "^4.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "tailwindcss": "^3.4.17"
  }
}
